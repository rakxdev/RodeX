{
  "name": "rodexdb",
  "version": "0.5.1",
  "description": "Official TypeScript client for RodexDB \u2014 per-app keys & tables on DynamoDB, one clean API. Point it at any RodexDB gateway (your own deploy or the live instance).",
  "keywords": [
    "rodexdb",
    "database",
    "dynamodb",
    "cloudflare",
    "serverless",
    "mcp",
    "rest"
  ],
  "license": "SEE LICENSE IN LICENSE",
  "type": "module",
  "main": "./dist/cjs/index.cjs",
  "types": "./dist/esm/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/esm/index.d.ts",
      "import": "./dist/esm/index.js",
      "require": "./dist/cjs/index.cjs"
    }
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "node build.mjs",
    "test": "vitest run"
  },
  "devDependencies": {
    "@types/node": "^26.0.0",
    "typescript": "^5.6.0",
    "vitest": "^4.1.10",
    "esbuild": "^0.25.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/rakxdev/RodeX"
  },
  "homepage": "https://rodexdb.pages.dev",
  "bugs": {
    "url": "https://github.com/rakxdev/RodeX/issues"
  }
}
