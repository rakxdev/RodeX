# RodeX dashboard — Cloudflare Pages headers.
# HTML is no-store: the SPA is excluded from back/forward cache (bfcache),
# so logged-out users can never be restored onto the app board.
# Hashed assets are immutable and cached for a year.
/*
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY
  Referrer-Policy: no-referrer
  Content-Security-Policy: default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src 'self' https://rodex-gateway.rakxdev.workers.dev; frame-ancestors 'none'
  Strict-Transport-Security: max-age=15552000
  Cache-Control: no-store
*/
/assets/*
  Cache-Control: public, max-age=31536000, immutable
