/*
  Cloudflare Pages security headers for the RodeX dashboard.
  Applied on next `npm run deploy:dashboard`.
  NOTE: inline <script> blocks in index.html/docs.html need 'unsafe-inline';
        tighten to script-src 'self' after moving scripts to files (future).
*/
/*
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY
  Referrer-Policy: no-referrer
  Content-Security-Policy: default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src 'self' https://rodex-gateway.rakxdev.workers.dev; frame-ancestors 'none'
  Strict-Transport-Security: max-age=15552000
*/
